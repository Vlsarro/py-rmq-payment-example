# Copy to .env and adjust. All variables use the APP_ prefix.

# --- Application -----------------------------------------------------------
APP_LOG_LEVEL=INFO
APP_API_KEY=dev-secret-key
APP_WEBHOOK_SECRET=dev-webhook-secret

# --- PostgreSQL ------------------------------------------------------------
APP_DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# --- Webhook delivery ------------------------------------------------------
APP_WEBHOOK_TIMEOUT=10.0
# Comma-separated host allowlist. Empty means "allow any host".
# Set to e.g. "webhook-sink,localhost" to block internal SSRF targets.
APP_WEBHOOK_ALLOWED_HOSTS=