# Copy to .env and adjust. All variables use the APP_ prefix.

# --- Application -----------------------------------------------------------
APP_LOG_LEVEL=INFO
APP_API_KEY=dev-secret-key
APP_WEBHOOK_SECRET=dev-webhook-secret

# --- PostgreSQL ------------------------------------------------------------
APP_DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# --- RabbitMQ --------------------------------------------------------------
APP_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
APP_CONSUMER_PREFETCH=4

# --- Webhook delivery ------------------------------------------------------
APP_WEBHOOK_TIMEOUT=10.0
# Comma-separated host allowlist. Empty means "allow any host".
# Set to e.g. "webhook-sink,localhost" to block internal SSRF targets.
APP_WEBHOOK_ALLOWED_HOSTS=

# --- Payment gateway emulator ---------------------------------------------
APP_GATEWAY_SUCCESS_RATE=0.9
APP_GATEWAY_MIN_DELAY=2.0
APP_GATEWAY_MAX_DELAY=5.0

# --- Retry / DLQ -----------------------------------------------------------
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_BASE_TTL_MS=5000
APP_RETRY_TTL_MS=30000

# --- Outbox relay ----------------------------------------------------------
APP_OUTBOX_POLL_INTERVAL=0.5
APP_OUTBOX_BATCH_SIZE=50
APP_OUTBOX_MAX_ATTEMPTS=10

# --- Observability ---------------------------------------------------------
# When true, a subscriber drains payments.dlq (messages are logged and
# discarded). Leave false in production so the DLQ keeps its contents.
APP_DLQ_CONSUMER_ENABLED=false
